# Application
APP_NAME=Cortex
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (async SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5432/cortex
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Authentication / JWT (use a long random secret in every environment)
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Document storage
DOCUMENT_STORAGE_PATH=storage/documents
DOCUMENT_MAX_FILE_SIZE_BYTES=26214400
DOCUMENT_ALLOWED_MIME_TYPE=application/pdf
