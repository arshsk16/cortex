# =============================================================================
# .env.docker — Cortex Docker deployment configuration template
# =============================================================================
# USAGE
#   cp .env.docker .env.docker.local
#   # Fill in all values marked <CHANGE_ME> before running docker compose.
#   docker compose --env-file .env.docker.local up -d
#
# SECURITY
#   Never commit .env.docker.local to version control.
#   It is already listed in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=cortex
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=cortex
# Host port exposed to the host machine (change to avoid conflicts)
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Leave REDIS_PASSWORD empty to disable Redis AUTH (not recommended in prod)
REDIS_PASSWORD=<CHANGE_ME>
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=production
APP_NAME=Cortex
LOG_LEVEL=INFO
# Port exposed by the Cortex container on the host
CORTEX_PORT=8000

# ---------------------------------------------------------------------------
# Authentication — REQUIRED
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=<CHANGE_ME_generate_with_secrets_token_hex_32>

# ---------------------------------------------------------------------------
# CORS — space-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Google Gemini LLM — leave blank to use the stub/mock in tests
# ---------------------------------------------------------------------------
GEMINI_API_KEY=<CHANGE_ME_or_leave_blank>
GEMINI_MODEL_NAME=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Performance tuning
# ---------------------------------------------------------------------------
# Number of Uvicorn worker processes (increase for higher throughput)
WORKERS=2
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10

# ---------------------------------------------------------------------------
# ChromaDB collection names (usually fine to leave as defaults)
# ---------------------------------------------------------------------------
CHROMA_COLLECTION_NAME=document_chunks
CHROMA_MEMORY_COLLECTION_NAME=memories
